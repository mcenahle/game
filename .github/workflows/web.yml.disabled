name: Build Web

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Download RenPy
        run: |
          wget https://www.renpy.org/dl/8.5.3/renpy-8.5.3-sdk.tar.bz2
          tar -xf renpy-8.5.3-sdk.tar.bz2

      - name: Build Web
        run: |
          ./renpy-8.5.3-sdk/renpy.sh launcher web_build . --destination build

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: web-build
          path: build/*
